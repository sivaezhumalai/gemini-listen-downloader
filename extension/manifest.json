{
  "manifest_version": 3,
  "name": "Gemini Listen Downloader",
  "version": "1.2.0",
  "description": "Download, convert to MP3 and trim the audio Gemini plays when you click \"Listen\" on a response.",
  "homepage_url": "https://github.com/sivaezhumalai/gemini-listen-downloader",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["vendor/lame.min.js", "parse.js", "audio.js", "mp3.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
