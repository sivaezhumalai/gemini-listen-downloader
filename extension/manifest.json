{
  "manifest_version": 3,
  "name": "Gemini Listen Downloader",
  "version": "2.0.0",
  "description": "Retro tape deck for Gemini's \"Listen\" audio: save as OGG or MP3, trim, boost, shorten pauses, rename, share and keep a library.",
  "homepage_url": "https://github.com/sivaezhumalai/gemini-listen-downloader",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "vendor/lame.min.js",
        "parse.js",
        "audio.js",
        "store.js",
        "mp3.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
